{
  "installCommand": "npm ci",
  "buildCommand": "prisma generate && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/.prisma/**"
    }
  },
  "rewrites": [
    { "source": "/transpose", "destination": "/transpose.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
